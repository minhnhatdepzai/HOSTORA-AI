OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5:9b-q8_0
# Optional after held-out evaluation: only /api/ai/chat uses this model.
# OLLAMA_CHATBOT_MODEL=hostora-chatbot:4b-q8-20261023-v2
# Optional: use a smaller local model to draft Studio copy. CHAT_MODEL still audits it.
# OLLAMA_STUDIO_MODEL=hostora-chatbot:4b-q8-20261023-v2
OLLAMA_EMBED_MODEL=qwen3-embedding:4b
OLLAMA_CONTEXT_LENGTH=16384
HOSTORA_STUDIO_GITHUB_ENABLED=false
HOSTORA_STUDIO_GITHUB_OWNER=
OLLAMA_TIMEOUT_MS=90000
HOSTORA_MAX_AI_CONCURRENCY=1

# Đơn hàng HOSTORA: dùng `demo` để mô phỏng không thu tiền; dùng `sandbox` khi đã có khóa thử nghiệm riêng.
# Tạo mật khẩu >=16 ký tự và secret ngẫu nhiên >=32 ký tự trên máy chủ; không commit giá trị thật.
# HOSTORA_ADMIN_PASSWORD=
# HOSTORA_ADMIN_SESSION_SECRET=
# HOSTORA_PAYMENTS_DB_PATH=./data/runtime/payments.sqlite
# HOSTORA_PAYMENTS_MODE=demo
# HOSTORA_PUBLIC_BASE_URL=https://your-public-hostora.example
# Chỉ bật sau khi origin đã chặn truy cập trực tiếp và chỉ nhận request từ Cloudflare.
HOSTORA_TRUST_CLOUDFLARE_PROXY=false
# Dùng cho reverse proxy khác; không bật đồng thời nếu chưa xác minh chuỗi proxy.
HOSTORA_TRUST_PROXY=false

# Cloudflare Turnstile cho web: site key là public, secret chỉ tồn tại ở server.
# Tạo widget production/staging riêng và giới hạn hostname trong Cloudflare Dashboard.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# HOSTORA_TURNSTILE_SECRET_KEY=
# HOSTORA_TURNSTILE_HOSTNAMES=hostora.example,www.hostora.example
# HOSTORA_STRIPE_SECRET_KEY=sk_test_...
# HOSTORA_STRIPE_WEBHOOK_SECRET=whsec_...
# HOSTORA_VNPAY_TMN_CODE=
# HOSTORA_VNPAY_HASH_SECRET=
# HOSTORA_VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# HOSTORA_VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# HOSTORA_VNPAY_RETURN_URL=https://your-public-hostora.example/api/payments/vnpay/return

# Email đơn hàng dùng chung cho website, app và trang quản trị.
# Dùng mật khẩu ứng dụng SMTP, không dùng mật khẩu đăng nhập chính và không commit file .env.local.
# HOSTORA_SMTP_HOST=smtp.gmail.com
# HOSTORA_SMTP_PORT=465
# HOSTORA_SMTP_SECURE=true
# HOSTORA_SMTP_USER=orders@your-domain.example
# HOSTORA_SMTP_PASSWORD=
# HOSTORA_EMAIL_FROM=HOSTORA <orders@your-domain.example>
# HOSTORA_ORDER_NOTIFICATION_EMAIL=owner@your-domain.example
# HOSTORA_EMAIL_REPLY_TO=support@your-domain.example
# SMTP đã cấu hình cũng cho phép đăng nhập /admin/orders bằng mã 6 số gửi tới HOSTORA_ORDER_NOTIFICATION_EMAIL.
# Trước khi gửi thật: xác thực SPF, DKIM và DMARC cho tên miền ở HOSTORA_EMAIL_FROM.

# Langfuse tùy chọn: chỉ gửi metadata AI/phễu đã ẩn danh, không gửi prompt, nội dung demo hoặc PII.
# Chỉ bật sau khi tạo project riêng và kiểm chứng trace trên môi trường thử nghiệm.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Tạo repo riêng tư và tự đồng bộ code website sau mỗi lần khách chỉnh sửa.
# Cần gh auth login trên server hoặc GH_TOKEN được cấp trong môi trường chạy.
HOSTORA_STUDIO_GITHUB_ENABLED=false
HOSTORA_STUDIO_GITHUB_OWNER=
