{
  "name": "hostora-ai",
  "version": "0.1.0",
  "private": true,
  "description": "HOSTORA AI - local-first Vietnamese hosting advisor",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "dev:lan": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build --webpack && node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env.local .next/standalone/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rag:index": "node scripts/index-rag.mjs",
    "rag:evaluate": "node scripts/evaluate-rag.mjs",
    "rag:evaluate:live": "node scripts/evaluate-rag-live.mjs",
    "package:submission": "node scripts/package-submission.mjs",
    "ai:check": "node --env-file-if-exists=.env.local scripts/check-local-ai.mjs",
    "ai:evaluate:advisor": "node scripts/evaluate-advisor.mjs",
    "ai:evaluate:memory": "node scripts/evaluate-account-ai.mjs",
    "ai:load-test": "node scripts/benchmark-ai-load.mjs",
    "tunnel:cloudflare": "bash scripts/start-cloudflare-quick-tunnel.sh",
    "tunnel:cloudflare:stop": "bash scripts/stop-cloudflare-quick-tunnel.sh",
    "ai:train:dual": "bash scripts/start-dual-finetune.sh",
    "ai:train:status": "bash scripts/dual-finetune-status.sh",
    "ai:train:deep": "bash scripts/start-deep-finetune.sh",
    "ai:train:deep:status": "bash scripts/deep-finetune-status.sh",
    "ai:train:chatbot": "bash scripts/start-chatbot-v6-finetune.sh",
    "ai:train:chatbot:status": "bash scripts/chatbot-v6-finetune-status.sh",
    "ai:train:chatbot:v7": "bash scripts/start-chatbot-v7-finetune.sh",
    "ai:train:chatbot:v7:status": "bash scripts/chatbot-v7-finetune-status.sh",
    "ai:train:chatbot:v8": "bash scripts/start-chatbot-v8-finetune.sh",
    "ai:train:chatbot:v8:status": "HOSTORA_TRAIN_RUN=chatbot-v8 HOSTORA_TRAIN_UNIT=hostora-chatbot-v8-finetune.service bash scripts/dual-finetune-status.sh",
    "ai:train:studio": "bash scripts/start-studio-v3-finetune.sh",
    "ai:train:studio:status": "bash scripts/studio-v3-finetune-status.sh",
    "studio:feedback-report": "node scripts/report-site-studio-feedback.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "agent:doctor": "node scripts/agent-tooling.mjs doctor",
    "agent:verify": "node scripts/agent-tooling.mjs verify",
    "test:e2e:isolated": "node scripts/agent-tooling.mjs e2e",
    "audit:ui": "node scripts/agent-tooling.mjs audit",
    "test:mobile:e2e": "node scripts/agent-tooling.mjs android",
    "android:update": "node scripts/agent-tooling.mjs update",
    "test:mobile:mcp": "node scripts/mobile-mcp-smoke.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@langchain/langgraph": "^1.5.2",
    "@langfuse/client": "^6.0.2",
    "@langfuse/otel": "^6.0.2",
    "@langfuse/tracing": "^6.0.2",
    "@opentelemetry/sdk-node": "^0.300.0",
    "animejs": "4.3.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "gsap": "3.15.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "unpdf": "2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
